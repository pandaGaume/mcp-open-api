{
    "name": "@cyanmycelium/mcp-open-api",
    "version": "0.1.0",
    "description": "Turns an OpenAPI spec into an mcp-broker slot: a declarative slot definition, validated and published by a Tier 4 operator, governed by the broker.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (CyanMycelium)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/mcp-open-api.git"
    },
    "homepage": "https://github.com/pandaGaume/mcp-open-api#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/mcp-open-api/issues"
    },
    "keywords": [
        "mcp",
        "openapi",
        "rest",
        "slot-definition",
        "mcp-broker",
        "cyanmycelium"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "bench": "node bench/run.mjs",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@cyanmycelium/mcp-core": "^1.4.1"
    },
    "devDependencies": {
        "@cyanmycelium/mcp-broker": "^1.6.1",
        "@cyanmycelium/mcp-broker-provider": "^0.4.1",
        "@cyanmycelium/mcp-core": "^1.4.1",
        "@types/node": "^20.11.0",
        "prettier": "^3.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vite": "8.3.2",
        "vitest": "4.1.11"
    }
}
