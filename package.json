{
    "name": "@cyanmycelium/mcp-open-api",
    "version": "0.1.0",
    "description": "Turns an OpenAPI spec into an mcp-broker slot: a declarative slot definition, validated and published by a Tier 4 operator, governed by the broker.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (CyanMycelium)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/mcp-open-api.git"
    },
    "homepage": "https://github.com/pandaGaume/mcp-open-api#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/mcp-open-api/issues"
    },
    "keywords": [
        "mcp",
        "openapi",
        "rest",
        "slot-definition",
        "mcp-broker",
        "cyanmycelium"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "bin": {
        "mcp-open-api": "./dist/bin.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./compiler": {
            "types": "./dist/compiler/index.d.ts",
            "import": "./dist/compiler/index.js"
        },
        "./host": {
            "types": "./dist/host/index.d.ts",
            "import": "./dist/host/index.js"
        },
        "./designer": {
            "types": "./dist/designer/index.d.ts",
            "import": "./dist/designer/index.js"
        },
        "./schemas/binding-1.schema.json": "./schemas/binding-1.schema.json"
    },
    "files": [
        "dist",
        "schemas",
        "ui"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "bench": "node bench/run.mjs",
        "demo:designer": "node scripts/designer-demo.mjs",
        "smoke": "node --input-type=module -e \"await import('./dist/index.js'); await import('./dist/compiler/index.js'); await import('./dist/host/index.js'); await import('./dist/designer/index.js'); console.log('dist entries load')\" && node scripts/serve-check.mjs",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"ui/**/*.{js,html,css}\" \"scripts/*.mjs\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"ui/**/*.{js,html,css}\" \"scripts/*.mjs\"",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@cyanmycelium/mcp-core": "^1.4.1"
    },
    "devDependencies": {
        "@cfworker/json-schema": "^4.1.1",
        "@cyanmycelium/mcp-broker": "^1.7.0",
        "@cyanmycelium/mcp-core": "^1.4.1",
        "@types/node": "^20.11.0",
        "prettier": "^3.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vite": "8.3.2",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "@cyanmycelium/mcp-broker-provider": "^0.4.1",
        "@cyanmycelium/mcp-uns": "^0.1.0",
        "ajv": "^8.20.0",
        "re2js": "^2.8.6",
        "yaml": "^2.9.1"
    }
}
